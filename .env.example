# Destila: environment variables.
# Copy this file to .env.local and fill it in. NEVER commit real values.
# Empty values fall back to the defaults documented in README.md.

# --- Supabase (Postgres + Auth) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- Upstash Redis (rate limiting) ----------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI provider ------------------------------------------------------------
# "gemini" (development, default) or "claude" (production)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# --- Meta-prompts (private, never in the repo) ------------------------------
# "example" (public example, default), "env" or "database"
METAPROMPT_SOURCE=
# JSON with the private meta-prompts when METAPROMPT_SOURCE=env
DESTILA_METAPROMPTS=

# --- Limits -----------------------------------------------------------------
DAILY_FREE_QUOTA=
MAX_INPUT_CHARS=
MAX_OUTPUT_TOKENS=
DAILY_GLOBAL_BUDGET_USD=
# "true" pauses the service immediately (manual kill switch)
KILL_SWITCH_FORCE=
